$VERSION = "0.4.11";
$CODENAME = "Caravanserai";
$CONF_FILE = "/etc/nomail/nomail.conf";
$MAILQ = "/var/spool/nomail/";
($host) = gethostbyname(hostname);
$remote_host = "localhost";
